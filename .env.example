# Copie para .env (ignorado pelo git): cp .env.example .env

# Banco de dados (docker-compose / execução local)
DB_NAME=vagaviva
DB_USER=vagaviva
DB_PASSWORD=vagaviva
DB_HOST=localhost
DB_PORT=5432

# Aplicação
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local
AWS_REGION=sa-east-1

# Senhas locais de desenvolvimento (em hml/prod vêm do Secrets Manager)
# Administrador inicial, criado no primeiro start se não houver nenhum ADMIN (RF-03)
BOOTSTRAP_ADMIN_EMAIL=admin@vagaviva.local
BOOTSTRAP_ADMIN_PASSWORD=Admin@Local2026
DEMO_USERS_PASSWORD=Demo@Local2026

# Filas locais (ElasticMQ, compatível com SQS)
SQS_ENDPOINT=http://localhost:9324

# Chave RS256 dos tokens: Base64 de um PEM PKCS#8 (uma linha). Obrigatória no perfil aws.
# Vazia localmente = par efêmero (tokens invalidados a cada restart). Para gerar:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | base64 | tr -d '\n'
JWT_PRIVATE_KEY=
