# Copie para .env (ignorado pelo git): cp .env.example .env

# Banco de dados (docker-compose / execução local)
DB_NAME=vagaviva
DB_USER=vagaviva
DB_PASSWORD=vagaviva
DB_HOST=localhost
DB_PORT=5432

# Aplicação
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local
AWS_REGION=sa-east-1

# Senhas locais de desenvolvimento (em hml/prod vêm do Secrets Manager)
BOOTSTRAP_ADMIN_PASSWORD=Admin@Local2026
DEMO_USERS_PASSWORD=Demo@Local2026

# Filas locais (ElasticMQ, compatível com SQS)
SQS_ENDPOINT=http://localhost:9324
